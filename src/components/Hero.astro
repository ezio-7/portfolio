---
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="top" class="relative pt-20 pb-16 sm:pt-28">
  <div class="grid-bg pointer-events-none absolute inset-0 -z-10"></div>

  <div class="flex items-center gap-4">
    <div class="relative shrink-0">
      <img
        src={`${base}${profile.avatar}`}
        alt={profile.name}
        width="88"
        height="88"
        class="avatar h-[72px] w-[72px] rounded-full object-cover sm:h-[88px] sm:w-[88px]"
      />
      <span class="absolute right-0.5 bottom-0.5 h-3 w-3 rounded-full border-2 border-bg bg-accent"></span>
    </div>
    <div>
      <h1 class="text-[26px] leading-tight font-semibold tracking-tight sm:text-[30px]">{profile.name}</h1>
      <p class="mt-1 flex flex-wrap font-mono text-[11.5px] text-muted">
        <span class="whitespace-nowrap">{profile.role}</span>
        {profile.focus.map((f) => <span class="whitespace-nowrap"><span class="mx-1.5 text-faint">/</span>{f}</span>)}
      </p>
    </div>
  </div>

  <p class="mt-7 max-w-[560px] text-[15px] leading-relaxed text-ink/90">{profile.tagline}</p>

  <!-- signature: a record flowing down a tiny pipeline -->
  <div class="mt-7 max-w-[560px]" aria-hidden="true">
    <svg viewBox="0 0 560 24" class="w-full overflow-visible">
      <path id="hero-line" d="M2 12 H558" stroke="var(--color-line-2)" stroke-width="1" />
      <path d="M2 12 H558" stroke="var(--color-accent)" stroke-width="1.4" class="flow" opacity="0.55" />
      {
        ['ingest', 'validate', 'map', 'match', 'transform', 'deliver'].map((s, i) => (
          <g transform={`translate(${2 + i * 111.2} 12)`}>
            <circle r="3.5" fill="var(--color-bg)" stroke="var(--color-line-2)" />
            <text y="-9" text-anchor={i === 0 ? 'start' : i === 5 ? 'end' : 'middle'} class="fill-faint font-mono" font-size="9.5">
              {s}
            </text>
          </g>
        ))
      }
      <circle r="3" fill="var(--color-accent)" class="motion-dot" style="filter: drop-shadow(0 0 4px var(--color-accent))">
        <animateMotion dur="4.5s" repeatCount="indefinite" path="M2 12 H558" />
      </circle>
    </svg>
  </div>

  <div class="mt-8 flex flex-wrap gap-2">
    <a class="btn btn-primary" href={`${base}${profile.resume}`} download>
      Resume <span aria-hidden="true">↓</span>
    </a>
    <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub ↗</a>
    <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    <a class="btn" href={`mailto:${profile.email}`}>Email</a>
  </div>
</section>

<style>
  .avatar {
    box-shadow:
      0 0 0 1px var(--color-line-2),
      0 0 0 5px var(--color-bg),
      0 0 0 6px var(--color-accent-dim);
    /* tame the bright passport-blue background on a dark page */
    filter: saturate(0.82) brightness(0.95);
  }
</style>
