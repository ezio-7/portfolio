---
import SectionHead from './SectionHead.astro';
import { skills, education, achievements } from '../data/profile';
---

<section id="toolkit" class="py-16">
  <SectionHead idx="05" name="toolkit" title="Skills, education and achievements" />

  <div class="reveal card divide-y divide-line">
    {
      skills.map((s) => (
        <div class="flex flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center">
          <p class="w-36 shrink-0 font-mono text-[10.5px] tracking-wide text-faint uppercase">{s.group}</p>
          <div class="flex flex-wrap gap-1.5">
            {s.items.map((i) => <span class="tag text-ink/90">{i}</span>)}
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-3 grid gap-3 md:grid-cols-[1fr_1.2fr]">
    <div class="reveal card p-4">
      <p class="stage-label mb-2">education</p>
      <p class="text-[13.5px] font-medium">{education.school}</p>
      <p class="text-[12.5px] text-muted">{education.degree}</p>
      <p class="mt-2 font-mono text-[11px] text-faint">{education.period} · GPA {education.gpa}</p>
    </div>
    <div class="reveal card p-4">
      <p class="stage-label mb-2">achievements</p>
      <ul class="space-y-1.5">
        {
          achievements.map((a) => (
            <li class="relative pl-4 text-[12.5px] text-ink/85">
              <span class="absolute top-[9px] left-0 h-1 w-1 rounded-full bg-accent" />
              {a}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
