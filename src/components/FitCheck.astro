---
import { fitSkills, myYears } from '../data/fitcheck';
---

<dialog id="fit" class="fit" aria-labelledby="fit-title">
  <div class="card max-h-[calc(100vh-40px)] overflow-y-auto border-line-2 p-5" style="background: var(--color-pop)">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="stage-label"><b>fit check</b> / for recruiters</p>
        <h3 id="fit-title" class="mt-1 text-[16px] font-medium">Paste a job description</h3>
        <p class="text-[12px] text-muted">Runs in your browser. Nothing is sent anywhere.</p>
      </div>
      <button type="button" class="btn px-2.5 fit-close" aria-label="Close">esc ✕</button>
    </div>

    <textarea
      id="fit-jd"
      rows="7"
      placeholder="e.g. We're hiring a Backend Engineer with 3+ years of Java / Spring Boot, PostgreSQL, Kafka and Kubernetes on AWS…"
      class="mt-4 w-full resize-y rounded-lg border border-line-2 bg-bg p-3 text-[12.5px] text-ink outline-none focus:border-accent"
    ></textarea>
    <div class="mt-2 flex items-center justify-between gap-2">
      <button type="button" id="fit-sample" class="font-mono text-[10.5px] text-faint hover:text-accent">use a sample JD</button>
      <button type="button" id="fit-go" class="btn btn-primary">check fit</button>
    </div>

    <div id="fit-out" class="mt-5 hidden">
      <div class="flex items-center gap-4">
        <svg viewBox="0 0 36 36" class="h-16 w-16 -rotate-90" aria-hidden="true">
          <circle cx="18" cy="18" r="15.5" fill="none" stroke="var(--color-line-2)" stroke-width="3" />
          <circle id="fit-ring" cx="18" cy="18" r="15.5" fill="none" stroke="var(--color-accent)" stroke-width="3" stroke-linecap="round" stroke-dasharray="0 100" pathLength="100" />
        </svg>
        <div>
          <p class="text-[24px] leading-none font-medium text-accent"><span id="fit-score">0</span>% match</p>
          <p id="fit-summary" class="mt-1 text-[12px] text-muted"></p>
        </div>
      </div>
      <p id="fit-years" class="mt-3 hidden text-[12px] text-muted"></p>

      <p class="stage-label mt-4 mb-2">matched · click to see the evidence</p>
      <div id="fit-have" class="flex flex-wrap gap-1.5"></div>
      <p class="stage-label mt-4 mb-2">not on this page</p>
      <div id="fit-gap" class="flex flex-wrap gap-1.5"></div>
    </div>
  </div>
</dialog>

<script type="application/json" id="fit-data" set:html={JSON.stringify({ fitSkills, myYears })} />

<style>
  dialog.fit {
    width: min(620px, 100vw - 24px); margin: 8vh auto auto; padding: 0; border: 0;
    background: transparent; color: inherit;
  }
  dialog.fit::backdrop { background: rgb(4 5 6 / 0.6); backdrop-filter: blur(3px); }
  dialog.fit[open] { animation: pop 0.16s ease; }
  :global(.fit-chip) { cursor: pointer; border-color: rgb(196 240 77 / 0.45); color: var(--color-accent); }
  :global(.fit-chip:hover) { background: var(--color-accent-dim); }
</style>

<script>
  type S = { name: string; jd: string; have: boolean; find?: string; flags?: string };
  const { fitSkills, myYears } = JSON.parse(document.getElementById('fit-data')!.textContent!) as { fitSkills: S[]; myYears: number };
  const dlg = document.getElementById('fit') as HTMLDialogElement;
  const jd = document.getElementById('fit-jd') as HTMLTextAreaElement;
  const out = document.getElementById('fit-out')!;
  const sample =
    'Backend Engineer (SDE-2). 3+ years building backend services in Java (Spring Boot) or Python. Strong SQL with PostgreSQL or MySQL, query optimisation and performance tuning. Experience with microservices, REST APIs, Docker and Kubernetes on AWS. Kafka or RabbitMQ is a plus. CI/CD, observability, and good system design fundamentals. Healthcare domain experience preferred.';

  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const check = () => {
    const text = jd.value;
    if (!text.trim()) { jd.focus(); return; }
    const found = fitSkills.filter((s) => new RegExp(s.jd, s.flags ?? 'i').test(text));
    const have = found.filter((s) => s.have), gap = found.filter((s) => !s.have);
    const score = found.length ? Math.round((have.length / found.length) * 100) : 0;

    out.classList.remove('hidden');
    document.getElementById('fit-score')!.textContent = String(score);
    document.getElementById('fit-ring')!.setAttribute('stroke-dasharray', `${score} 100`);
    document.getElementById('fit-summary')!.textContent = found.length
      ? `${have.length} of ${found.length} skills this role mentions are evidenced on this page.`
      : "I didn't recognise specific technologies in that text. Try pasting the requirements section.";

    const yrs = [...text.matchAll(/(\d{1,2})\s*\+?\s*(?:-\s*\d+\s*)?(?:years|yrs)/gi)].map((m) => +m[1]).filter((n) => n < 20);
    const yEl = document.getElementById('fit-years')!;
    if (yrs.length) {
      const ask = Math.min(...yrs);
      yEl.textContent = ask <= myYears
        ? `Experience: asks for ${ask}+ years · I have ${myYears}+ years full-time ✓`
        : `Experience: asks for ${ask}+ years · I have ${myYears}+ years full-time, plus 3 engineering internships`;
      yEl.classList.remove('hidden');
    } else yEl.classList.add('hidden');

    document.getElementById('fit-have')!.innerHTML = have.length
      ? have.map((s) => `<button type="button" class="tag fit-chip" data-name="${esc(s.name)}" data-find="${esc(s.find ?? '')}">✓ ${esc(s.name)}</button>`).join('')
      : '<span class="text-[12px] text-faint">none</span>';
    document.getElementById('fit-gap')!.innerHTML = gap.length
      ? gap.map((s) => `<span class="tag">${esc(s.name)}</span>`).join('')
      : '<span class="text-[12px] text-faint">nothing, every skill mentioned is covered</span>';

    (window as any).track?.('fit-check', `Fit check: ${score}%`);
    (window as any).badge?.('fit');
  };

  document.getElementById('fit-go')!.addEventListener('click', check);
  document.getElementById('fit-sample')!.addEventListener('click', () => { jd.value = sample; check(); });
  document.getElementById('fit-have')!.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.fit-chip');
    if (!b) return;
    dlg.close();
    (window as any).filterSkill?.(b.dataset.name, b.dataset.find || undefined);
  });
  dlg.querySelector('.fit-close')!.addEventListener('click', () => dlg.close());
  dlg.addEventListener('click', (e) => e.target === dlg && dlg.close());
  const open = () => {
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d.close());
    dlg.showModal();
    jd.focus();
  };
  document.querySelectorAll('.fit-open').forEach((b) => b.addEventListener('click', open));
  (window as any).openFit = open;
</script>
