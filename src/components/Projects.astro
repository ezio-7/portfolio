---
import SectionHead from './SectionHead.astro';
import ProjectCover from './ProjectCover.astro';
import { projects } from '../data/projects';
---

<section id="projects" class="py-16">
  <SectionHead idx="04" name="projects" title="Things I've built on the side" />
  <div class="grid gap-3 sm:grid-cols-2">
    {
      projects.map((p) => (
        <article class="project reveal card flex flex-col overflow-hidden transition-colors hover:border-line-2">
          <div class="h-[110px] border-b border-line bg-bg">
            <ProjectCover motif={p.motif} />
          </div>
          <div class="flex flex-1 flex-col p-4">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="text-[14px] font-medium">{p.name}</h3>
            <p class="font-mono text-[10px] text-faint">{p.context}</p>
          </div>
          <p class="mt-1.5 flex-1 text-[12.5px] text-muted">{p.description}</p>
          <div class="mt-3 flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap gap-1.5">
              {p.stack.map((s) => <span class="tag">{s}</span>)}
            </div>
            <div class="flex gap-3 font-mono text-[11px]">
              <a href={p.repo} target="_blank" rel="noopener" class="text-muted hover:text-accent">code ↗</a>
              {p.demo && (
                <a href={p.demo} target="_blank" rel="noopener" class="text-muted hover:text-accent">live ↗</a>
              )}
            </div>
          </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
