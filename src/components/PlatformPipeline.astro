---
import { platformStages } from '../data/experience';

// Snake layout: first half left→right, second half right→left
const perRow = Math.ceil(platformStages.length / 2);
const W = 700, pillW = 118, pillH = 30, gap = (W - 20 - perRow * pillW) / (perRow - 1);
const y1 = 32, y2 = 108;
const pos = platformStages.map((s, i) => {
  const row = i < perRow ? 0 : 1;
  const col = row === 0 ? i : perRow - 1 - (i - perRow);
  return { ...s, n: i + 1, x: 10 + col * (pillW + gap), y: row === 0 ? y1 : y2 };
});
const cx = (p: { x: number }) => p.x + pillW / 2;
const first = pos[0], lastTop = pos[perRow - 1], firstBottom = pos[perRow], last = pos[pos.length - 1];
const path =
  `M${cx(first)} ${y1} H${cx(lastTop)} ` +
  `C${W + 6} ${y1}, ${W + 6} ${y2}, ${cx(firstBottom)} ${y2} H${cx(last)}`;
---

<div class="my-5 rounded-xl border border-line bg-surface/60 p-4">
  <p class="stage-label mb-3">platform pipeline · hover or tap a stage</p>

  <!-- desktop / tablet: animated snake -->
  <svg viewBox={`0 0 ${W} 140`} class="hidden w-full overflow-visible sm:block" role="img" aria-label="Platform pipeline stages">
    <path d={path} fill="none" stroke="var(--color-line-2)" stroke-width="1" />
    <path d={path} fill="none" stroke="var(--color-accent)" stroke-width="1.4" class="flow" opacity="0.5" />
    {
      [0, 1.6, 3.2, 4.8].map((b) => (
        <circle r="2.8" fill="var(--color-accent)" class="motion-dot" style="filter: drop-shadow(0 0 4px var(--color-accent))">
          <animateMotion dur="6.4s" begin={`${b}s`} repeatCount="indefinite" path={path} />
        </circle>
      ))
    }
    {
      pos.map((p) => (
        <g class="stage" data-tip={p.tip} tabindex="0">
          <rect x={p.x} y={p.y - pillH / 2} width={pillW} height={pillH} rx="15" />
          <text x={p.x + 12} y={p.y + 3.5} class="fill-faint font-mono" font-size="9">
            {String(p.n).padStart(2, '0')}
          </text>
          <text x={p.x + 30} y={p.y + 4} class="fill-ink" font-size="11">
            {p.name}
          </text>
        </g>
      ))
    }
  </svg>

  <!-- mobile: vertical list -->
  <ol class="relative space-y-2 pl-5 sm:hidden">
    <span class="absolute top-1 bottom-1 left-[3px] w-px bg-line"></span>
    {
      pos.map((p) => (
        <li class="relative" data-tip={p.tip}>
          <span class="absolute top-[7px] -left-5 h-[7px] w-[7px] rounded-full border border-accent bg-bg" />
          <span class="mr-2 font-mono text-[10px] text-faint">{String(p.n).padStart(2, '0')}</span>
          <span class="text-[12.5px]">{p.name}</span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .stage rect {
    fill: var(--color-bg);
    stroke: var(--color-line-2);
    transition: stroke 0.15s, fill 0.15s;
  }
  .stage {
    cursor: help;
    outline: none;
  }
  .stage:hover rect,
  .stage:focus rect {
    stroke: var(--color-accent);
    fill: #12160c;
  }
</style>
