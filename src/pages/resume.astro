---
// Tracked résumé link: /portfolio/resume/?ref=acme logs "resume-open@acme" in GoatCounter, then opens the résumé
// (the Google Drive copy when set, otherwise the PDF on this site).
import { profile } from '../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const pdf = profile.resumeDrive || `${base}${profile.resume}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{profile.name} · Résumé</title>
    <noscript><meta http-equiv="refresh" content={`0; url=${pdf}`} /></noscript>
    <style>
      body { background: #08090b; color: #9aa0a8; font: 14px/1.6 ui-sans-serif, system-ui, sans-serif; display: grid; place-items: center; min-height: 100vh; margin: 0; }
      a { color: #c4f04d; }
    </style>
  </head>
  <body>
    <p>Opening the résumé… <a href={pdf}>open it directly</a></p>
    <script is:inline define:vars={{ pdf }}>
      var ref = (new URLSearchParams(location.search).get('ref') || '').toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 40);
      var path = ref ? 'resume-open@' + ref : 'resume-open';
      var url = 'https://ayushanand.goatcounter.com/count?p=' + encodeURIComponent(path) + '&e=true&t=' + encodeURIComponent('Résumé opened' + (ref ? ' · ' + ref : '')) + '&rnd=' + Math.random().toString(36).slice(2);
      // keepalive lets the hit finish even though we navigate away right after
      var local = /^(localhost|127\.|\[::1\])/.test(location.hostname);
      if (!local) try { fetch(url, { mode: 'no-cors', keepalive: true }); } catch (e) {}
      setTimeout(function () { location.replace(pdf); }, 150);
    </script>
  </body>
</html>
