---
import '../styles/global.css';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const title = `${profile.name} · ${profile.role}`;
const description = `${profile.name}, ${profile.role} (${profile.focus.join(', ')}). ${profile.tagline}`;
const pageUrl = new URL(base, Astro.site).href;
// Structured data so search engines know this page is about a person
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  url: pageUrl,
  image: new URL(`${base}${profile.avatar}`, Astro.site).href,
  email: `mailto:${profile.email}`,
  sameAs: [profile.links.github, profile.links.linkedin],
  worksFor: { '@type': 'Organization', name: 'HiLabs' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indian Institute of Technology Kharagpur' },
  knowsAbout: ['Backend Engineering', 'Python', 'Java', 'Spring Boot', 'SQL', 'MySQL', 'PostgreSQL', 'Kubernetes', 'Azure', 'AWS'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="author" content={profile.name} />
    <meta name="google-site-verification" content="3IAaoU6RQG5R1kqu8drQrj6HEn3hJ88bX4n9NR1--TQ" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, Astro.site)} />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(`${base}og.png`, Astro.site)} />
    <meta name="theme-color" content="#08090b" />
    <script is:inline>
      // apply a saved theme before first paint (no flash)
      try { if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light'; } catch (e) {}
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <!-- GoatCounter analytics: anonymous page views, dashboard at ayushanand.goatcounter.com -->
    <script is:inline data-goatcounter="https://ayushanand.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <slot />
    <div id="tip" aria-hidden="true"></div>
    <script>
      // Shared tooltip for any element with data-tip (diagram nodes, pipeline stages)
      const tip = document.getElementById('tip')!;
      let pinned: Element | null = null;
      const show = (el: Element, x: number, y: number) => {
        // An open <dialog> sits in the top layer, so the tooltip must live inside it
        const host = el.closest('dialog[open]') || document.body;
        if (tip.parentElement !== host) host.appendChild(tip);
        tip.textContent = el.getAttribute('data-tip');
        const w = tip.offsetWidth, h = tip.offsetHeight;
        tip.style.left = Math.min(x + 14, innerWidth - w - 8) + 'px';
        tip.style.top = (y + h + 22 > innerHeight ? y - h - 12 : y + 16) + 'px';
        tip.classList.add('on');
      };
      const hide = () => tip.classList.remove('on');
      document.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const el = (e.target as Element).closest?.('[data-tip]');
        el ? show(el, e.clientX, e.clientY) : hide();
      });
      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest?.('[data-tip]');
        if (el && el !== pinned) {
          pinned = el;
          const r = el.getBoundingClientRect();
          show(el, r.left + r.width / 2, r.top + r.height / 2);
        } else {
          pinned = null;
          hide();
        }
      });
      document.addEventListener('scroll', () => { pinned = null; hide(); }, { passive: true });

      // Theme toggle (dark is the default; the choice is remembered)
      const setTheme = (t: string) => {
        if (t === 'light') document.documentElement.dataset.theme = 'light';
        else delete document.documentElement.dataset.theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'light' ? '#f6f6f3' : '#08090b');
        document.querySelectorAll('.theme-toggle').forEach((b) => (b.textContent = t === 'light' ? '☾' : '☀'));
        try { localStorage.setItem('theme', t); } catch {}
      };
      const current = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');
      setTheme(current());
      document.querySelectorAll('.theme-toggle').forEach((b) =>
        b.addEventListener('click', () => {
          setTheme(current() === 'light' ? 'dark' : 'light');
          (window as any).track?.(`theme-${current()}`, `Theme: ${current()}`);
        }),
      );
      (window as any).toggleTheme = () => setTheme(current() === 'light' ? 'dark' : 'light');

      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => entries.forEach((en) => en.isIntersecting && (en.target.classList.add('in'), io.unobserve(en.target))),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
